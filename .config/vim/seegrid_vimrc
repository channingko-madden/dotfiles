"nnoremap <space> za 

"----------Stop python PEP 8 stuff--------------
" c++ stuff
augroup cpp_stuff
	autocmd!
	" apply c++ syntax rules to (.ino/.pde) files
	autocmd BufNewFile,BufReadPost *.ino,*.pde,*.c,*.xbm set filetype=cpp
	"specific indentation for cpp
	autocmd FileType cpp set tabstop=4 shiftwidth=4 softtabstop=4 
	"autocmd FileType cpp set noexpandtab
	autocmd FileType cpp set colorcolumn=80
	"highlight matching braces
	autocmd FileType cpp set showmatch
	"highlight column 110 to keep lines 110 chars at most
	autocmd FileType cpp highlight ColorColumn
	" intelligent comments
	autocmd FileType cpp set comments=sl:/*,mb:\ *,elx:\ */
	" folding
	"autocmd FileType cpp set foldmethod=syntax
	"autocmd FileType cpp set foldlevelstart=99
	autocmd FileType cpp set nofoldenable "disable folding
augroup END

