"enable vim to source .vimrc file is present in working directory
set exrc
"secure option restricts some commands in non-default .vimrc files
set secure
set rtp+=~/.vim/bundle/Vundle.vim
call vundle#begin()

Plugin 'VundleVim/Vundle.vim'
Plugin 'preservim/nerdtree'
Plugin 'vim-syntastic/syntastic'
Plugin 'Valloric/YouCompleteMe'
Plugin 'rhysd/vim-clang-format'
Plugin 'octol/vim-cpp-enhanced-highlight'

call vundle#end()

filetype plugin indent on    " enables filetype detection, required
"let g:SimpylFold_docstring_preview = 1

"General 
set noswapfile "turn off swapfiles
set number "Show line numbers
set scrolloff=5 "2 lines above/below cursor when scrolling
set showcmd "show commands in bottom bar
set title "show file in titlebar
set shortmess=a "use abbreviations for status messages
set cmdheight=4 "give more space to display messages
" Set the default file encoding to UTF-8:
set encoding=utf-8
set fileformat=unix
" Use UNIX (\n) line endings.
"au BufNewFile *.py,*.pyw,*.c,*.h set fileformat=unix
" make backspaces more powerfull
set backspace=indent,eol,start
set completeopt-=preview "get rid of preview window for autocomplete
set nofoldenable "get rid of folding
" from VimForDevelopment page in the grid
set sw=4
set sts=4
set ts=4
set expandtab
set smarttab
set nolisp
set autoindent
set smartindent
set cindent
set modeline

set indentkeys=!!^F,o,O,<:>,0),0],0},=elif,=except

let mapleader = ".."

"YCM
"For seegrid ycm docker
let g:ycm_server_python_interpreter = 'ycmd-python'
let g:ycm_extra_conf_globlist = ['/checkout/src/*']
let g:ycm_confirm_extra_conf = 0
"let g:ycm_global_ycm_extra_conf = '~/.global_ycm_extra_conf.py'
"let g:ycm_error_symbol = '%%'
"let g:ycm_warning_symbol = '%'
let g:ycm_max_diagnostics_to_display = 500
let g:ycm_enable_diagnostic_signs = 1
let g:ycm_enable_diagnostic_highlighting = 1
let g:ycm_always_populate_location_list = 1 "default 0
let g:ycm_open_loclist_on_ycm_diags = 1 "default 1
let g:ycm_show_diagnostics_ui = 1 " change back to default 1
"let g:ycm_key_list_select_completion=[]
"let g:ycm_key_list_previous_completion=[]
let g:ycm_add_preview_to_completeopt = 0 "no preview window
" let g:ycm_autoclose_preview_window_after_completion=1
let g:ycm_complete_in_comments = 1 "show completion menu when typing in comments
let g:ycm_complete_in_strings = 1 "show completion menu when typing inside strings
let g:ycm_auto_hover = ""
nnoremap <leader>yj :YcmCompleter GoToDefinitionElseDeclaration<CR>
"map getting hover documentation
nmap <leader>D <plug>(YCMHover)
" vim-clang-format
let g:clang_format#detect_style_file = 1 " detect .clang-format file

"syntastic
set statusline+=%#warningmsg#
set statusline+=%{SyntasticStatuslineFlag()}
set statusline+=%*

" let g:syntastic_cpp_compiler = 'g++' " should not need to explicitly say
" let g:syntastic_cpp_compiler_options = '-std=c++17'
let g:syntastic_always_populate_loc_lsit = 1
let g:syntastic_auto_loc_list = 1
let g:syntastic_check_on_open = 1
let g:syntastic_check_on_wq = 0

" Font style 
set guifont=Monaco:h18
colorscheme molokai
let g:rehash256 = 1
syntax on
highlight LineNr cterm=NONE ctermbg=NONE ctermfg=Grey gui=NONE guibg=NONE guifg=Grey

" File structure 
let NERDTreeIgnore=['\.pyc$', '\~$'] "ignore files in NERDTree
map <C-n> :NERDTreeToggle<CR>
nmap <leader>ne :NERDTree<cr>

"------------Start Python PEP 8 stuff----------------
" Number of spaces that a pre-existing tab is equal to.

augroup python_stuff
	autocmd!
"it would be nice to set tag files by the active virtualenv here
":set tags=~/mytags "tags for ctags and taglist
"omnicomplete
	autocmd FileType python set omnifunc=pythoncomplete#Complete
	autocmd FileType python setlocal tabstop=4 shiftwidth=4 softtabstop=4
"Folding based on indentation:
	autocmd FileType python set foldmethod=indent
	autocmd FileType python set indentexpr=
augroup END
